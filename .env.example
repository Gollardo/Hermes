# Copy this file to .env. These are development examples, not production secrets.
COMPOSE_PROJECT_NAME=hermes
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=4200

POSTGRES_DB=hermes
POSTGRES_USER=hermes
# Replace before exposing the application beyond a local development machine.
POSTGRES_PASSWORD=change-me-with-a-long-random-password

# Optional runtime tuning.
HERMES_DATABASE_ECHO=false
# Keep true for HTTPS deployments. Set false only for loopback-only plain HTTP.
HERMES_COOKIE_SECURE=true
HERMES_SESSION_LIFETIME_DAYS=7
HERMES_SESSION_IDLE_MINUTES=30
HERMES_LOGIN_FAILURE_LIMIT=5
HERMES_LOGIN_FAILURE_WINDOW_MINUTES=15
HERMES_LOGIN_BLOCK_MINUTES=15
HERMES_LOGIN_ADMISSION_INTERVAL_MS=250
# JSON array of exact proxy networks; forwarded client addresses are ignored by default.
HERMES_TRUSTED_PROXY_NETWORKS=[]
